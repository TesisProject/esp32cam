/* ============================================================================
 *  secrets.h.example  -  PLANTILLA de credenciales
 *
 *  Este fichero SI se versiona; secrets.h NO (lo ignora .gitignore).
 *
 *  Para poner en marcha el proyecto:
 *    1. Copia este fichero a  secrets.h   (en la misma carpeta)
 *    2. Rellena los tres valores de abajo
 *    3. Compila
 *
 *  Hay 3 unidades fisicas (CAM-001, CAM-002, CAM-003): cada una necesita su
 *  propio secrets.h con su propio DEVICE_ID/API_KEY/API_TOKEN antes de
 *  flashearla. Es provisional: con el alta por MAC (E7) la camara obtendra
 *  su credencial sola y este fichero desaparecera.
 *
 *  La WiFi YA NO va aqui: se graba por USB en la NVS de cada placa con
 *  scripts/provision.ps1 (ver README). Si tu secrets.h aun tiene
 *  WIFI_SSID/WIFI_PASSWORD, borralos: config.h los anula y no se usan.
 *
 *  En Windows, desde la carpeta del sketch:
 *      copy secrets.h.example secrets.h
 * ==========================================================================*/
#pragma once

/* --- Identidad de esta camara y credenciales de la API --------------------
 *  API_KEY/API_TOKEN van en headers y son lo que identifica a la camara ante
 *  el Fog (la URL no lleva id). DEVICE_ID solo sale en el log de arranque,
 *  para saber que unidad se ha flasheado: debe coincidir con el camera_id
 *  que el Fog asocia a esa credencial. Se piden en el backend (Raspberry Pi)
 *  al dar de alta cada camara. */
#define DEVICE_ID    "CAM-001"      // CAMBIAR por CAM-002 / CAM-003 segun la unidad
#define API_KEY      "TU_API_KEY"
#define API_TOKEN    "TU_API_TOKEN"
