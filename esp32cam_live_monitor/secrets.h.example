/* ============================================================================
 *  secrets.h.example  -  PLANTILLA de credenciales
 *
 *  Este fichero SI se versiona; secrets.h NO (lo ignora .gitignore).
 *
 *  Para poner en marcha el proyecto:
 *    1. Copia este fichero a  secrets.h   (en la misma carpeta)
 *    2. Rellena los cinco valores de abajo
 *    3. Compila
 *
 *  Hay 3 unidades fisicas (CAM-001, CAM-002, CAM-003): cada una necesita su
 *  propio secrets.h con su propio DEVICE_ID/API_KEY/API_TOKEN antes de
 *  flashearla. El WiFi es el mismo para las tres.
 *
 *  En Windows, desde la carpeta del sketch:
 *      copy secrets.h.example secrets.h
 * ==========================================================================*/
#pragma once

/* --- Red WiFi (la de la Raspberry Pi / fog node) --------------------------
 *  Tiene que ser una red de 2,4 GHz: el ESP32 no ve las de 5 GHz.         */
#define WIFI_SSID              "TU_RED_WIFI"
#define WIFI_PASSWORD          "TU_PASSWORD"

/* --- Identidad de esta camara y credenciales de la API --------------------
 *  API_KEY/API_TOKEN van en los headers X-API-Key / X-API-Token y son lo
 *  UNICO que identifica a la camara ante el Fog: el id no viaja ni en la URL
 *  ni en el cuerpo. Cada unidad tiene su pareja propia; grabar la de otra
 *  hace que sus fotos entren en la zona equivocada sin dar ningun error.
 *  Las tres parejas salen del Fog al dar de alta las camaras.
 *
 *  DEVICE_ID se queda solo como etiqueta local para el log por serie: el id
 *  que vale es el camera_id que devuelve la respuesta 202 del Fog. */
#define DEVICE_ID    "CAM-001"      // CAMBIAR por CAM-002 / CAM-003 segun la unidad
#define API_KEY      "TU_API_KEY"
#define API_TOKEN    "TU_API_TOKEN"
