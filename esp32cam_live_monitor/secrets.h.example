/* ============================================================================
 *  secrets.h.example  -  PLANTILLA de credenciales
 *
 *  Este fichero SI se versiona; secrets.h NO (lo ignora .gitignore).
 *
 *  Para poner en marcha el proyecto:
 *    1. Copia este fichero a  secrets.h   (en la misma carpeta)
 *    2. Rellena los cuatro valores de abajo
 *    3. Compila
 *
 *  En Windows, desde la carpeta del sketch:
 *      copy secrets.h.example secrets.h
 * ==========================================================================*/
#pragma once

/* --- Tu red WiFi (el router) ---------------------------------------------
 *  Tiene que ser una red de 2,4 GHz: el ESP32 no ve las de 5 GHz.         */
#define WIFI_SSID              "TU_RED_WIFI"
#define WIFI_PASSWORD          "TU_PASSWORD"

/* --- Red propia del ESP32 (modos AP y AP_FALLBACK) -----------------------
 *  La contrasena necesita 8 caracteres COMO MINIMO. Con menos (o con "")
 *  la red se crea abierta, sin cifrado.                                    */
#define WIFI_AP_SSID           "ESP32CAM-Monitor"
#define WIFI_AP_PASSWORD       "CAMBIA_ESTA_CLAVE"
